# OSINT Brazuca Ultimate - Configurações de Ambiente

# Rede e Servidor (Sempre 127.0.0.1 por padrão de segurança e privacidade)
OSINT_HOST=127.0.0.1
OSINT_PORT=8000

# Histórico Local (false por padrão - desativado para pesquisas sensíveis)
OSINT_ENABLE_HISTORY=false

# Timeouts e Concorrência Segura
OSINT_TIMEOUT=12.0
OSINT_MAX_CONCURRENCY=5
OSINT_MAX_UPLOAD_MB=15

# User-Agent de Identificação Ética
OSINT_USER_AGENT=OSINT-Brazuca-Ultimate/1.0 (Pesquisa Legitima em Fontes Abertas; contato@osintbrazuca.local)

